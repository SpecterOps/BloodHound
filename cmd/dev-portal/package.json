{
    "name": "dev-portal",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "lint": "oxlint src --report-unused-disable-directives-severity error --max-warnings 0",
        "check-types": "tsc --noEmit --pretty",
        "format": "prettier --write \"src/**/*.@(js|jsx|ts|tsx|md|html|css|scss|json)\"",
        "check-format": "prettier --list-different \"src/**/*.@(js|jsx|ts|tsx|md|html|css|scss|json)\""
    },
    "dependencies": {
        "@fontsource/figtree": "^5.2.10",
        "@fontsource/nunito-sans": "^5.2.10",
        "@fortawesome/fontawesome-svg-core": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@fortawesome/react-fontawesome": "^3.0.2",
        "doodle-ui": "workspace:*",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.30.6"
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.9.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.20",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "patch:eslint-plugin-react@npm%3A7.34.1#~/.yarn/patches/eslint-plugin-react-npm-7.34.1-93be695b40.patch",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "jsdom": "^27.0.0",
        "oxlint": "1.89.0",
        "postcss": "^8.5.23",
        "prettier": "^3.2.5",
        "prettier-plugin-organize-imports": "^4.1.0",
        "tailwindcss": "^3.4.17",
        "tinyglobby": "^0.2.17",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vitest": "npm:^4.1.11"
    }
