{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "doodle-ui": ["../../packages/javascript/doodle-ui/src"]
        },
        "types": ["vitest/globals", "@testing-library/jest-dom"]
    },
    "include": ["src", "../../packages/javascript/doodle-ui/src/tanstack-table.d.ts"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
