{
    "name": "js-client-library",
    "type": "module",
    "packageManager": "yarn@3.5.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "audit": "yarn npm audit --recursive",
        "build": "yarn check-types && rollup --config rollup.config.js",
        "lint": "oxlint src --report-unused-disable-directives-severity error --max-warnings 0",
        "test": "echo \"Warning: no test specified\"",
        "check-types": "tsc --noEmit --pretty",
        "format": "prettier --write \"src/**/*.@(js|jsx|ts|tsx|md|html|css|scss|json)\"",
        "check-format": "prettier  --list-different \"src/**/*.@(js|jsx|ts|tsx|md|html|css|scss|json)\""
    },
    "dependencies": {
        "axios": "1.20.0"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^11.1.6",
        "@vitest/coverage-v8": "^4.1.11",
        "oxlint": "1.89.0",
        "prettier": "^3.2.5",
        "prettier-plugin-organize-imports": "^4.1.0",
        "rollup": "^4.59.0",
        "rollup-plugin-delete": "^2.0.0",
        "typescript": "^5.9.3"
    }
}
